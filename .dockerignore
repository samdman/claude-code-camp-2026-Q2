week0_explore/HOW_TO_PLAY.md

# .NET build artifacts (explicit, not "**/bin" -- that would also match
# week0_explore/mud_manager/bin, which is a tracked Ruby script directory, not build output)
week2_capable/dotnet/**/bin
week2_capable/dotnet/**/obj
