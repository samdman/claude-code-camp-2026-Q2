        else:
            respond(request_id, {"content": [{"type": "text", "text": f"error: unknown tool '{name}'"}], "isError": True})
    else:
        if request_id is not None:
            print(
                json.dumps({"jsonrpc": "2.0", "id": request_id, "error": {"code": -32601, "message": f"Method not found: {method}"}}),
